{
  "name": "portal-gd-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --use-system-ca --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copiar-assets.mjs",
    "start": "node --use-system-ca dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:limpar": "tsx --env-file=.env scripts/db-teste.ts",
    "recarregar": "tsx --env-file=.env scripts/recarregar.ts",
    "db:start": "tsx scripts/db-local.ts start",
    "db:stop": "tsx scripts/db-local.ts stop",
    "db:limpar": "tsx scripts/db-local.ts limpar",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx --env-file=.env prisma/seed/index.ts",
    "db:studio": "prisma studio",
    "comparar:perdas": "tsx --env-file=.env scripts/comparar-perdas.ts",
    "vincular-variaveis": "tsx --env-file=.env scripts/vincular-variaveis-gerencia.ts"
  },
  "comentarioOverrides": "GHSA-ggr8-5vv4-36mx: deepmerge-ts <8 tem stack exhaustion ao mesclar grafos recursivos. Chega via @prisma/config (devDependency, fora da imagem de producao). Nao ha versao do Prisma corrigida ate 7.10, entao o override resolve sem esperar upstream. Remover quando o Prisma atualizar.",
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "dependencies": {
    "@date-fns/tz": "^1.2.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/csrf-protection": "^7.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/swagger": "^9.4.2",
    "@prisma/client": "^6.3.1",
    "@scalar/fastify-api-reference": "^1.25.128",
    "argon2": "^0.41.1",
    "date-fns": "^4.1.0",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "oracledb": "^7.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/oracledb": "^7.0.2",
    "dotenv": "^16.4.7",
    "embedded-postgres": "16.14.0-beta.17",
    "eslint": "^9.19.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.23.0",
    "vitest": "^3.0.5"
  }
}
