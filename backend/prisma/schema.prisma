model FatoCusto {
  id           String   @id(map: "fato_custo_pk") @default(uuid()) @db.Uuid
  filialId     String   @map("filial_id") @db.Uuid
  /// Indicador a que este fato pertence.
  ///
  /// Ate 24/08/2026 o vinculo estava no NOME da tabela: `fato_venda`
  /// significava vendas porque se chamava assim. Com indicadores filhos
  /// isso deixa de funcionar - `Vendas construcao` tem fato proprio, com a
  /// mesma forma. A coluna torna explicito o que era implicito.
  ///
  /// ATENCAO: a ingestao substitui JANELA. O `DELETE` do periodo tem de
  /// filtrar por este campo, senao carregar um filho apaga o pai.
  indicadorId  String   @map("indicador_id") @db.Uuid
  ano          Int
  mes          Int
