// ─────────────────────────────────────────────────────────────────────────────
// Pareto — gerado dentro do portal, nunca expurgado
// ─────────────────────────────────────────────────────────────────────────────

/// Marcacao de ponto de causa na reuniao do N4.
///
/// Uma linha por (ponto de causa, area de venda, ano, SEMANA), com a
/// quantidade. Ate 26/08/2026 era uma linha por ocorrencia, com timestamp e
/// filial -- e nesse formato "editar a marcacao da S3" nao tinha como
/// acontecer, so' inserir mais uma. Ver PLANO 7.11.
///
/// FILIAL NAO ESTA AQUI de proposito: `dimensao_area_venda` ja' a tem. Manter
/// as duas abriria a possibilidade de divergirem -- ocorrencia na CEN
/// apontando area de venda da NOR, sem nada impedir.
///
/// O Pareto e' `SUM(quantidade) GROUP BY ponto_causa`, filtrado por area e
/// periodo. Marcacoes sao registro historico de ocorrencia de problema:
/// expurga-las destruiria o Pareto e deixaria contramedidas apontando para
/// causa sem lastro.
model OcorrenciaPontoCausa {
  id           String         @id(map: "ocorrencia_ponto_causa_pk") @default(uuid()) @db.Uuid
  pontoCausaId String         @map("ponto_causa_id") @db.Uuid
  /// Contra o que esta ocorrencia foi marcada. Ver `EscopoMarcacao`.
  escopo       EscopoMarcacao @default(AREA_VENDA)
  /// O id do alvo, na tabela que `escopo` indica. SEM chave estrangeira: ela
  /// nao aponta para duas tabelas. Quem valida e' a trigger, como em `Meta`.
  alvoId       String         @map("alvo_id") @db.Uuid
  ano          Int
  mes          Int
  /// Semana DO MES (1..5), nao semana ISO do ano.
  ///
  /// E' o que a grade da reuniao mostra (S1..S5) e o que o ciclo do GD usa -- o
  /// ciclo e' o mes. A regra de quais dias caem em cada semana ja' existe em
  /// `lib/semanas.ts`. Semana ISO obrigaria a traduzir S1..S5 para 31..35 toda
  /// vez que a tela falasse com o banco, e e' nessa traducao que o off-by-one
  /// mora.
  semana       Int
  /// Sempre maior que zero: celula zerada tem a linha REMOVIDA, nao zerada.
  /// Guardar zero encheria o Pareto de causas que ninguem apontou.
  quantidade   Int

  /// Quem marcou por ultimo -- com contador editavel, e o autor da ultima
  /// alteracao, nao o da primeira.
  registradoPorId String   @map("registrado_por_id") @db.Uuid
  /// Quando a marcacao foi feita. Comparado com `ano`+`semana`, revela
  /// marcacao retroativa -- que e' PERMITIDA e fica visivel no dado, em vez de
  /// proibida. Ver PLANO 7.8.
  registradoEm    DateTime @default(now()) @map("registrado_em")
  atualizadoEm    DateTime @default(now()) @updatedAt @map("atualizado_em")

  pontoCausa    PontoCausa @relation(fields: [pontoCausaId], references: [id], map: "ocorrencia_ponto_causa_ponto_causa_fk")
  registradoPor Usuario    @relation(fields: [registradoPorId], references: [id], map: "ocorrencia_ponto_causa_usuario_fk")

  @@unique([pontoCausaId, escopo, alvoId, ano, mes, semana], map: "ocorrencia_ponto_causa_uk01")
  @@index([pontoCausaId], map: "ocorrencia_ponto_causa_idx01")
  @@index([alvoId], map: "ocorrencia_ponto_causa_idx02")
  @@index([registradoPorId], map: "ocorrencia_ponto_causa_idx03")
  @@index([alvoId, ano, mes], map: "ocorrencia_ponto_causa_idx04")
  @@map("ocorrencia_ponto_causa")
}

// ─────────────────────────────────────────────────────────────────────────────
// Contramedidas
//
// status ('Em andamento' | 'Atrasada' | 'Escalada' | 'Concluída'), SLA
// (ok/risco/crítico) e "em aberto há" NÃO são colunas: derivam de concluidaEm,
// prazo, criadoEm e da última movimentação, na leitura. Coluna de status
// envelhece sozinha — uma contramedida viraria "Atrasada" só com a passagem do
// tempo, e precisaria de um job para isso.
//
// `codigo` vem da SEQUENCE contramedida_codigo_seq (ver migration), dentro da
// transação de criação. MAX()+1 no app quebra sob concorrência.
// ─────────────────────────────────────────────────────────────────────────────

model Contramedida {
  id                 String     @id(map: "contramedida_pk") @default(uuid()) @db.Uuid
  codigo             String     @unique(map: "contramedida_uk01") @db.VarChar(20)
  titulo             String
  pdcRef             String?    @map("pdc_ref")
  pontoCausaId       String?    @map("ponto_causa_id") @db.Uuid
  variavelControleId String?    @map("variavel_controle_id") @db.Uuid
  indicadorId        String?    @map("indicador_id") @db.Uuid
  filialId           String     @map("filial_id") @db.Uuid
  nivelAtual         Nivel      @map("nivel_atual")
  bucketId           String     @map("bucket_id") @db.Uuid
  responsavelAtualId String     @map("responsavel_atual_id") @db.Uuid
  criadoPorId        String     @map("criado_por_id") @db.Uuid
  criadoEm           DateTime   @default(now()) @map("criado_em")
  prazo              DateTime   @db.Date
  prioridade         Prioridade
  concluidaEm        DateTime?  @map("concluida_em")
  comentarioAbertura String     @map("comentario_abertura")
  origem             String?

  filial           Filial            @relation(fields: [filialId], references: [id], map: "contramedida_filial_fk")
  bucket           Bucket            @relation(fields: [bucketId], references: [id], map: "contramedida_agrupamento_fk")
  pontoCausa       PontoCausa?       @relation(fields: [pontoCausaId], references: [id], map: "contramedida_ponto_causa_fk")
  variavelControle VariavelControle? @relation(fields: [variavelControleId], references: [id], map: "contramedida_variavel_controle_fk")
  indicador        Indicador?        @relation(fields: [indicadorId], references: [id], map: "contramedida_indicador_fk")
  responsavelAtual Usuario           @relation("ContramedidaResponsavel", fields: [responsavelAtualId], references: [id], map: "contramedida_usuario02_fk")
  criadoPor        Usuario           @relation("ContramedidaCriador", fields: [criadoPorId], references: [id], map: "contramedida_usuario01_fk")

  movimentacoes Movimentacao[]
  comentarios   Comentario[]

  @@index([nivelAtual, filialId], map: "contramedida_idx02")
  @@index([responsavelAtualId], map: "contramedida_idx03")
  @@index([criadoEm], map: "contramedida_idx01")
  @@index([bucketId], map: "contramedida_idx04")
  @@index([criadoPorId], map: "contramedida_idx05")
  @@index([filialId], map: "contramedida_idx06")
  @@index([indicadorId], map: "contramedida_idx07")
  @@index([pontoCausaId], map: "contramedida_idx08")
  @@index([responsavelAtualId], map: "contramedida_idx09")
  @@index([variavelControleId], map: "contramedida_idx10")
  @@map("contramedida")
}

/// Log imutável: só INSERT, nunca UPDATE nem DELETE. É a auditoria do fluxo.
///
/// ATENÇÃO à escalação para CROSS: ela NÃO transfere a responsabilidade.
/// `nivelDestino = CROSS` e `bucketDestinoId` registram o setor de apoio, mas
/// `responsavelDestinoId` aponta de volta para quem escalou — o setor de apoio
/// é visibilidade, e quem age continua sendo o usuário do nível de origem.
/// Contraria a leitura natural do campo, daí o destaque.
model Movimentacao {
  id                   String              @id(map: "movimentacao_pk") @default(uuid()) @db.Uuid
  contramedidaId       String              @map("contramedida_id") @db.Uuid
  tipo                 TipoMovimentacao
  autorId              String              @map("autor_id") @db.Uuid
  criadoEm             DateTime            @default(now()) @map("criado_em")
  nivelOrigem          Nivel               @map("nivel_origem")
  nivelDestino         Nivel               @map("nivel_destino")
  bucketDestinoId      String?             @map("bucket_destino_id") @db.Uuid
  responsavelDestinoId String              @map("responsavel_destino_id") @db.Uuid
  motivo               String?
  texto                String
  novoPrazo            DateTime?           @map("novo_prazo") @db.Date
  resultadoIndicador   ResultadoIndicador? @map("resultado_indicador")

  contramedida       Contramedida @relation(fields: [contramedidaId], references: [id], map: "movimentacao_contramedida_fk")
  autor              Usuario      @relation("MovimentacaoAutor", fields: [autorId], references: [id], map: "movimentacao_usuario01_fk")
  responsavelDestino Usuario      @relation("MovimentacaoDestino", fields: [responsavelDestinoId], references: [id], map: "movimentacao_usuario02_fk")
  bucketDestino      Bucket?      @relation(fields: [bucketDestinoId], references: [id], map: "movimentacao_agrupamento_fk")

  @@index([contramedidaId, criadoEm], map: "movimentacao_idx01")
  @@index([autorId], map: "movimentacao_idx02")
  @@index([bucketDestinoId], map: "movimentacao_idx03")
  @@index([contramedidaId], map: "movimentacao_idx04")
  @@index([responsavelDestinoId], map: "movimentacao_idx05")
  @@map("movimentacao")
}

/// Comentário fora do fluxo de escalação — não movimenta a contramedida.
model Comentario {
  id             String   @id(map: "comentario_pk") @default(uuid()) @db.Uuid
  contramedidaId String   @map("contramedida_id") @db.Uuid
  autorId        String   @map("autor_id") @db.Uuid
  criadoEm       DateTime @default(now()) @map("criado_em")
  texto          String

  contramedida Contramedida @relation(fields: [contramedidaId], references: [id], map: "comentario_contramedida_fk")
  autor        Usuario      @relation(fields: [autorId], references: [id], map: "comentario_usuario_fk")

  @@index([contramedidaId, criadoEm], map: "comentario_idx01")
  @@index([autorId], map: "comentario_idx02")
  @@index([contramedidaId], map: "comentario_idx03")
  @@map("comentario")
}

// ─────────────────────────────────────────────────────────────────────────────
// Operação
// ─────────────────────────────────────────────────────────────────────────────

/// Alimenta o selo "ATUALIZADO {hora}" do header, o diagnóstico quando um
/// número parecer errado, e o alerta de "carga não chegou hoje".
/// Dado obsoleto é pior que dado ausente: se a carga falha, o portal segue
/// mostrando o último valor bom, mas o selo exibe a data DAQUELE dado.
model SyncExecucao {
  id              String     @id(map: "execucao_sincronizacao_pk") @default(uuid()) @db.Uuid
  fonte           String     @db.VarChar(30)
  iniciadoEm      DateTime   @default(now()) @map("iniciado_em")
  finalizadoEm    DateTime?  @map("finalizado_em")
  status          StatusSync @default(EM_ANDAMENTO)
  periodoDe       DateTime   @map("periodo_de") @db.Date
  periodoAte      DateTime   @map("periodo_ate") @db.Date
  linhasRecebidas Int        @default(0) @map("linhas_recebidas")
  linhasGravadas  Int        @default(0) @map("linhas_gravadas")
  linhasRemovidas Int        @default(0) @map("linhas_removidas")
  erro            String?
  origemIp        String?    @map("origem_ip")

  fatoVendas        FatoVendas[]
  fatoVendasLinha   FatoVendasLinha[]
  fatoNps           FatoNps[]
  fatoPerdas        FatoPerdas[]
  fatoMovimentacao  FatoMovimentacao[]
  fatoVendaVendedor FatoVendaVendedor[]
  vendedorMes       VendedorMes[]
  diasUteis         DiaUtil[]

  @@index([fonte, status, iniciadoEm], map: "execucao_sincronizacao_idx01")
  @@map("execucao_sincronizacao")
}

model RefreshToken {
  id         String    @id(map: "renovacao_sessao_pk") @default(uuid()) @db.Uuid
  usuarioId  String    @map("usuario_id") @db.Uuid
  tokenHash  String    @unique(map: "renovacao_sessao_uk01") @map("token_hash")
  /// Rotação com detecção de reuso: se um token já usado reaparecer, toda a
  /// família é revogada e o usuário precisa logar de novo.
  familiaId  String    @map("familia_id") @db.Uuid
  expiraEm   DateTime  @map("expira_em")
  revogadoEm DateTime? @map("revogado_em")
  userAgent  String?   @map("user_agent")
  ip         String?
  criadoEm   DateTime  @default(now()) @map("criado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade, map: "renovacao_sessao_usuario_fk")

  @@index([usuarioId], map: "renovacao_sessao_idx02")
  @@index([familiaId], map: "renovacao_sessao_idx01")
  @@index([usuarioId], map: "renovacao_sessao_idx03")
  @@map("renovacao_sessao")
}

model AuditLog {
  id         String   @id(map: "log_auditoria_pk") @default(uuid()) @db.Uuid
  usuarioId  String?  @map("usuario_id") @db.Uuid
  acao       String
  entidade   String
  entidadeId String?  @map("entidade_id")
  payload    Json?
  ip         String?
  criadoEm   DateTime @default(now()) @map("criado_em")

  usuario Usuario? @relation(fields: [usuarioId], references: [id], map: "log_auditoria_usuario_fk")

  @@index([entidade, entidadeId], map: "log_auditoria_idx02")
  @@index([criadoEm], map: "log_auditoria_idx01")
  @@index([usuarioId], map: "log_auditoria_idx03")
  @@map("log_auditoria")
}

/// Horario da carga automatica de uma fonte, editavel pela tela.
///
/// LINHA = OVERRIDE. Ausencia significa "usa a hora de `docs/n8n/fontes.mjs`",
/// que continua sendo o padrao — nao ha' seed. Semear copiaria o padrao para ca'
/// e criaria duas fontes de verdade: mudar o codigo depois nao teria efeito,
/// porque a copia no banco ganharia, e ninguem entenderia por que.
///
/// `janelaDias` NAO esta aqui de proposito. Ela nao e' preferencia, e' regra de
/// negocio: Perdas usa 730 dias porque uma quebra pendente vira aprovada meses
/// depois e altera um dia ja' fechado; movimentacao usa 60 porque nota fiscal nao
/// se reclassifica assim. Num campo de tela, alguem a baixaria sem saber disso e
/// o passado pararia de se corrigir — sem erro nenhum.
model CargaAgendamento {
  /// Nome da fonte em `fontes.mjs`. Sem FK: a lista de fontes e' codigo.
  fonte         String   @id(map: "carga_agendamento_pk")
  /// No fuso de TZ_APP, nao em UTC — a regra e' "03:15 em Recife".
  hora          Int
  minuto        Int
  atualizadoEm  DateTime @default(now()) @map("atualizado_em")
  atualizadoPor String?  @map("atualizado_por") @db.Uuid

  usuario Usuario? @relation(fields: [atualizadoPor], references: [id], map: "carga_agendamento_usuario_fk")

  @@index([atualizadoPor], map: "carga_agendamento_idx01")
  @@map("carga_agendamento")
}
